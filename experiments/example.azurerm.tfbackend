# Copy to <environment>.azurerm.tfbackend (git-ignored) and fill in.
# The state key is not set here: pass it per experiment and variant on init,
# for example -backend-config="key=awa-poc/windows-provisioning/win11.tfstate".
resource_group_name  = "<state resource group>"
storage_account_name = "<state storage account>"
container_name       = "<state container>"
subscription_id      = "<subscription id of the state storage account>"
tenant_id            = "<tenant id>"
use_azuread_auth     = true
